<svg width="800" height="800" xmlns="http://www.w3.org/2000/svg">
  <!-- Pozadí -->
  <rect width="800" height="800" fill="#f5f6f7"/>

  <!-- Jednoduchá ilustrace kotlu -->
  <g transform="translate(400, 400)">
    <!-- Tělo kotlu -->
    <rect x="-150" y="-200" width="300" height="350" fill="#6c757d" stroke="#2c3e50" stroke-width="3" rx="10"/>

    <!-- Horní část - poklice -->
    <ellipse cx="0" cy="-200" rx="160" ry="30" fill="#8B8B8B" stroke="#2c3e50" stroke-width="3"/>
    <ellipse cx="0" cy="-190" rx="140" ry="20" fill="#A0A0A0"/>

    <!-- Rukojeť poklice -->
    <rect x="-15" y="-220" width="30" height="25" fill="#5c5c5c" stroke="#2c3e50" stroke-width="2" rx="5"/>

    <!-- Spodní část -->
    <rect x="-150" y="150" width="300" height="80" fill="#4a4a4a" stroke="#2c3e50" stroke-width="3"/>

    <!-- Nohy -->
    <rect x="-130" y="230" width="40" height="60" fill="#3a3a3a" stroke="#2c3e50" stroke-width="2"/>
    <rect x="90" y="230" width="40" height="60" fill="#3a3a3a" stroke="#2c3e50" stroke-width="2"/>

    <!-- Detail - kouřové hrdlo -->
    <circle cx="-100" cy="0" r="25" fill="#5c5c5c" stroke="#2c3e50" stroke-width="2"/>
    <circle cx="-100" cy="0" r="15" fill="#3a3a3a"/>

    <!-- Dvířka -->
    <rect x="-50" y="80" width="100" height="60" fill="#4a4a4a" stroke="#2c3e50" stroke-width="2" rx="5"/>
    <rect x="-40" y="90" width="80" height="40" fill="#3a3a3a" rx="3"/>
    <circle cx="30" cy="110" r="5" fill="#8B8B8B"/>
  </g>

  <!-- Text -->
  <text x="400" y="700" font-family="Arial, sans-serif" font-size="24" fill="#6c757d" text-anchor="middle">Pařák - Kotel 65 l</text>
  <text x="400" y="730" font-family="Arial, sans-serif" font-size="18" fill="#9ca3af" text-anchor="middle">Placeholder - nahraďte skutečným obrázkem</text>
</svg>
